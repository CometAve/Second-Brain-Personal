# =============================================================================
# SecondBrain Extension 환경 변수 예시
# =============================================================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# cp .env.example .env

# API 서버 URL
VITE_API_BASE_URL=http://localhost:8080

# Knowledge Graph 서버 URL (/ai/api/v1 경로는 코드에서 추가)
VITE_KG_API_BASE_URL=http://localhost:8000

# 노트 상세 화면을 여는 웹 주소
VITE_WEB_URL=http://localhost:5173

# Google OAuth Client ID
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
# 형식: [PROJECT_NUMBER]-[RANDOM_STRING].apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
