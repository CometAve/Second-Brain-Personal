# 개인 로컬 개발용 예제. 외부 서비스의 실제 키는 .env에만 입력한다.
POSTGRES_PASSWORD=local-postgres-password
REDIS_PASSWORD=local-redis-password
NEO4J_PASSWORD=local-neo4j-password
RABBITMQ_USER=secondbrain
RABBITMQ_PASSWORD=local-rabbit-password
RABBITMQ_HOSTNAME=rabbitmq

POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BACKEND_PORT=8080
AI_PORT=8000

# 기존 확장의 content script가 현재 웹페이지 origin에서 API를 직접 호출한다.
CORS_ALLOWED_ORIGIN=*

# Cloud 인증이 없으면 AI 호출은 실패하며, 데이터 서비스 기동은 가능하다.
# 실제 연결은 google-cloud.md의 ADC 및 Compose 추가 설정을 따른다.
GOOGLE_CLOUD_PROJECT=local-not-configured
GOOGLE_CLOUD_LOCATION=global
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.8-flash
SUMMARIZE_MODEL=gemini-3.8-flash
SEARCH_AGENT_MODEL=gemini-3.7-flash
RABBITMQ_QUEUE=note_creation_queue_gemini

# Google 로그인 사용 시 localhost:8080/login/oauth2/code/google 콜백을 등록한다.
GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
JWT_SECRET=local-development-only-secret-change-before-sharing-0123456789

# S3/Clova 기능은 실제 자격증명을 추가해야 사용할 수 있다.
# ACCESS_KEY=
# SECRET_ACCESS_KEY=
# REGION=
# BUCKET_NAME=
# S3_ENDPOINT=
# CLOVA_CLIENT_ID=
# CLOVA_CLIENT_SECRET=
# CLOVA_API_URL=
