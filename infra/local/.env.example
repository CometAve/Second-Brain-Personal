# 개인 로컬 개발용 예제. 외부 서비스의 실제 키는 .env에만 입력한다.
POSTGRES_PASSWORD=local-postgres-password
REDIS_PASSWORD=local-redis-password
NEO4J_PASSWORD=local-neo4j-password
RABBITMQ_USER=secondbrain
RABBITMQ_PASSWORD=local-rabbit-password

POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BACKEND_PORT=8080
AI_PORT=8000

# 기존 확장의 content script가 현재 웹페이지 origin에서 API를 직접 호출한다.
CORS_ALLOWED_ORIGIN=*

# 실제 AI 기능을 사용할 때 공급자 정보로 교체한다. 기본값은 외부로 요청하지 않는다.
OPENAI_API_KEY=local-placeholder
OPENAI_BASE_URL=http://127.0.0.1:9/v1
OPENAI_MODEL=text-embedding-3-small
SUMMARIZE_MODEL=gpt-4o-mini
SEARCH_AGENT_MODEL=gpt-4o-mini

# Google 로그인 사용 시 localhost:8080/login/oauth2/code/google 콜백을 등록한다.
GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
JWT_SECRET=local-development-only-secret-change-before-sharing-0123456789

# 백엔드 LLM/S3/Clova 기능은 실제 자격증명을 추가해야 사용할 수 있다.
# GMS_MODEL=
# GMS_EMBEDDING_MODEL=text-embedding-3-small
# GMS_API_KEY=
# GMS_OPENAI_BASE_URL=
# GMS_BASE_URL=
# ACCESS_KEY=
# SECRET_ACCESS_KEY=
# REGION=
# BUCKET_NAME=
# S3_ENDPOINT=
# CLOVA_CLIENT_ID=
# CLOVA_CLIENT_SECRET=
# CLOVA_API_URL=
